{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiMo-Code",
  "version": "0.1.9",
  "identifier": "com.mimo-ai.desktop",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MiMo-Code",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/opencode"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mimo", "opencode"]
      }
    }
  }
}
